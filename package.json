{
  "name": "dsh-auto-translate-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DSH GUI plugin (Web and Electron desktop): auto-translates foreign-language UI copy (typically Chinese) into Russian or English through DeepSeek Flash in an economical batched mode, with a local plugin-version-aware cache.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT"
}
